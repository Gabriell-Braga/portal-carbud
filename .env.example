# Endereço do painel Carbud, COM o mount path (de onde vêm estoque, lojas e leads).
PANEL_URL=https://crm.carbud.com.br/app

# Mesma chave cadastrada no painel (SITES_API_KEY). Vazia só funciona se o painel não exigir.
SITES_API_KEY=

# Origem pública do portal, para canonical, sitemap e Open Graph.
SITE_URL=https://carbud.com.br

# "Entrar com Google" (OAuth client "Web application"). Sem o Client ID o botão não aparece.
# Redirect URI cadastrado no Google: <SITE_URL>/api/auth/google/callback
# O painel precisa de GOOGLE_CLIENT_ID com o mesmo valor.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
